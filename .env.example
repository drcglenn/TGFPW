# Copy this file to ".env" for local testing. On Cloud Run, set these as
# environment variables instead - never commit real values to git.

# --- Who can use the app ----------------------------------------------------
# Your own Google account. Notes are saved into THIS account's Drive, and only
# this account can run the one-time Drive connection.
OWNER_EMAIL=cg@peakwellnesshtx.com

# Everyone allowed to sign in, comma separated. Include yourself.
ALLOWED_EMAILS=cg@peakwellnesshtx.com,mariana@peakwellnesshtx.com

# --- Google (SETUP.md Step 4) -----------------------------------------------
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Leave blank on first deploy. You fill it in after clicking
# "Connect Google Drive" in the app. SETUP.md Step 8.
DRIVE_REFRESH_TOKEN=

# The "Documentation" folder inside "PW Patient Resources".
# Already set to the practice's existing folder - only change it if it moves.
DOCUMENTATION_FOLDER_ID=1hh0SXMeAXutj3WibGtGptkmGkDVgt90a

# --- Claude (SETUP.md Step 5) -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- App --------------------------------------------------------------------
# Any long random string. SETUP.md Step 6 shows how to make one.
SESSION_SECRET=

# The https address of the deployed app. Fill in after your first deploy.
PUBLIC_URL=

# Only for testing on your own computer over http. Never set this on Cloud Run.
# INSECURE_COOKIES=1
